# Target MCU
CONFIG_IDF_TARGET="esp32s3"

# Verified physical flash baseline (8MB Quad, 3.3V)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Enable NimBLE host stack for low-footprint BLE advertising
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=0
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# USB-UART serial console diagnostics
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Onboard WS2812 RGB LED GPIOs (v1.1 = 38, v1.0 = 48)
CONFIG_POI_BEACON_STATUS_LED_GPIO=38
CONFIG_POI_BEACON_STATUS_LED_ALT_GPIO=48

